# lexmount_browser — credentials template.
#
#   cp secrets.env.example secrets.env && chmod 600 secrets.env
#   set -a; source secrets.env; set +a        # export BEFORE `gym env start` /
#                                             # the NeMo-RL launch, so spawned
#                                             # server processes inherit them
#
# secrets.env is intentionally NOT committed (and must never be). Every value
# below says where it comes from.

# --- Lexmount cloud browser (backend: lexmount; Stage C and full training) ---
# Provenance: register at https://browser.lexmount.com, create a project, and
# copy the API key + project ID from the dashboard. LEXMOUNT_BASE_URL is the
# JSON session API host (browser.lexmount.com serves HTML, api.lexmount.com
# serves the SDK API — use the api host).
LEXMOUNT_API_KEY=
LEXMOUNT_PROJECT_ID=
LEXMOUNT_BASE_URL=https://api.lexmount.com

# --- Policy endpoint (example.sh rollout stages; not used by training) -------
# Provenance: any OpenAI-compatible server that implements the Responses API
# (/v1/responses) AND parses tool calls into structured function_call items
# (vLLM: --enable-auto-tool-choice --tool-call-parser hermes). For training,
# NeMo-RL serves the policy itself and these are ignored.
POLICY_BASE_URL=
POLICY_API_KEY=
POLICY_MODEL=

# --- Trajectory-level LLM judge (the validated reward; see judge.py) ---------
# Provenance: any OpenAI-compatible chat-completions gateway that serves the
# judge model. The validated 0721 run judged with deepseek-v4-flash. The judge
# activates ONLY when all three values are set and the task opts in
# (verifier_metadata.judge: true, e.g. every row of data/webvoyager_clean.jsonl).
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=deepseek-v4-flash
# Optional overrides (defaults match the validated run):
# JUDGE_MAX_ATTEMPTS=3
# JUDGE_TRANSCRIPT_CHAR_LIMIT=60000
